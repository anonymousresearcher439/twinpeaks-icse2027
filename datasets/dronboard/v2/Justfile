drone_name := "Polkadot"

default:
    just --list

run:
    python src/dr_onboard_autonomy/state_machine.py _uav_name:={{drone_name}} _mqtt_host:=mqtt _local_mqtt_host:=mqtt_local _performance_analysis:=False

run_perf:
    python src/dr_onboard_autonomy/state_machine.py _uav_name:={{drone_name}} _mqtt_host:=mqtt _local_mqtt_host:=mqtt_local _performance_analysis:=True _comment:=`git rev-parse --short HEAD`

