unit-test:


send-mission NAME DRONE='Polkadot':
    cat ./missions/{{NAME}}.json |  mosquitto_pub -h localhost -t 'drone/{{DRONE}}/mission-spec' -s

list-missions:
    python scripts/list-missions.py

generate-drones NUM:
    python scripts/generate-drones.py {{NUM}}

list-simulations:
    echo local
    echo multi
    echo serial

simulate-local-px4 *FLAGS:
    docker compose -f ./docker/simulations/local-px4.yaml up {{FLAGS}}

simulate-local-ardupilot *FLAGS:
    docker compose -f ./docker/simulations/local-ardupilot.yaml up {{FLAGS}}

simulate-multi NUM_DRONES:
    just generate-drones {{NUM_DRONES}} && \
    docker compose -f ./docker/simulations/multi.yaml up

simulate-px4-serial:
    docker compose -f ./docker/simulations/px4-serial.yaml up

start-drone DRONE:
    docker compose -f ./docker/drone/{{DRONE}}.yaml up

purge-containers:
    docker ps -a --filter "name=^dr-onboard-autonomy-" -q | xargs docker rm -f