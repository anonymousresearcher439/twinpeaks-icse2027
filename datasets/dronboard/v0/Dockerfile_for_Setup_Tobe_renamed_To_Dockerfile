FROM ros:noetic-ros-base-focal

# install python packages
RUN apt update && apt install --yes \
    python-is-python3 \
    python3 \
    python3-pip \
    python3-venv \
    python3-wheel \
    python3-dev \   
    python3-catkin-tools

# install mavros
RUN apt install --yes \
    ros-noetic-smach \
    ros-noetic-mavros \
    ros-noetic-mavros-extras 

RUN apt install --yes vim

#install Mosquito MQTT
#RUN apt-get update
#RUN apt-get install mosquitto #'libev4 libwebsockets8 mosquitto' is the mosquito package

#install pymavlink and paho MQTT

RUN pip3 install pymavlink
RUN pip3 install paho-mqtt
RUN pip3 install nvector==0.7.6
RUN pip3 install PyGeodesy
RUN pip3 install http://docs.q3w.co/droneresponse_mathtools-0.2.0-py2.py3-none-any.whl
