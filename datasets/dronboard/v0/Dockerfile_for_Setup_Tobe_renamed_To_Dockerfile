#RUN pip3 install --user pyros-genmsg
#RUN pip3 install --user packaging
#RUN pip3 install --user jinja2
#RUN pip3 install --user toml

# clean up
RUN rm -rf /var/lib/apt/lists/*

COPY . /catkin_ws/src/
WORKDIR /catkin_ws
RUN /bin/bash -c '. /opt/ros/noetic/setup.bash; catkin_make'
RUN /bin/bash -c '. /opt/ros/noetic/setup.bash; source devel/setup.bash'
#RUN /bin/bash -c 'export DOCKER_GATEWAY_HOST=172.17.0.1'
RUN /bin/bash -c 'source ~/.bashrc'

