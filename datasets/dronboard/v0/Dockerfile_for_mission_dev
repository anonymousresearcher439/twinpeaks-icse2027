#Put the catkin_ws, PX4_Autopilot and the Dockerfile in the same parent directory


FROM ros:noetic-ros-base-focal

# install python packages
RUN apt update && apt install --yes \
    python-is-python3 \
    python3 \
    python3-pip \
    python3-venv \
    python3-wheel \
    python3-dev \   
    python3-catkin-tools

# install mavros
RUN apt install --yes \
    ros-noetic-smach \
    ros-noetic-mavros \
    ros-noetic-mavros-extras 

RUN apt install --yes vim

#install Mosquito MQTT
#RUN apt-get update
#RUN apt-get install mosquitto #'libev4 libwebsockets8 mosquitto' is the mosquito package

#install pymavlink and paho MQTT

RUN pip3 install pymavlink
RUN pip3 install paho-mqtt
RUN pip3 install nvector==0.7.6
RUN pip3 install PyGeodesy
RUN pip3 install http://docs.q3w.co/droneresponse_mathtools-0.2.0-py2.py3-none-any.whl

RUN geographiclib-get-geoids egm96-5 

# clean up
RUN rm -rf /var/lib/apt/lists/*

RUN echo "source /opt/ros/noetic/setup.bash" >> ~/.bashrc

COPY ./catkin_ws_new /catkin_ws_new
WORKDIR /catkin_ws_new
RUN /bin/bash -c '. /opt/ros/noetic/setup.bash; cd /catkin_ws_new; catkin_make'
RUN echo "source /catkin_ws_new/devel/setup.bash" >> ~/.bashrc
#RUN echo "cd ..; cd PX4-Autopilot; make px4_sitl jmavsim; cd ..; cd catkin_ws" >> ~/.bashrc
#RUN echo "roslaunch dr_onboard_autonomy launch_mavros_node.launch" >> ~/.bashrc
#RUN echo "rosrun dr_onboard_autonomy state_machine.py" >> ~/.bashrc


COPY ./PX4-Autopilot /PX4-Autopilot
WORKDIR /PX4-Autopilot

RUN /usr/bin/bash /PX4-Autopilot/Tools/setup/ubuntu.sh
RUN /usr/bin/make px4_sitl_default

ENV HEADLESS 1

ENV PX4_HOME_LAT 41.70573086523541
ENV PX4_HOME_LON -86.24421841999177
ENV PX4_HOME_ALT 0

