            /*
            When using `BetterCircle`, you might find it easier to think
            in terms of the drone's height above home and the circle's radius.

            By default, BetterCircle uses pitch and distance, which means height and
            radius must be calculated using trigonometry.

            To avoid doing that math, you can use this trick:
            1. Set "pitch" to 0.0
            2. Set "distance" to the desired radius
            3. Set the "relative_altitude" of "center_position" to the desired height
            */

            "pitch": 0.0, // this must be 0.0 for this trick to work
            "distance": 50.0, // This becomes the radius of the circle (since pitch is 0.0)
            "center_position": {
