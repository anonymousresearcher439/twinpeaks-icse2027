drone_name := "Polkadot"
gcs_host := "10.222.0.1"

default:
    just --list

run:
    python src/dr_onboard_autonomy/state_machine.py _uav_name:={{drone_name}} _mqtt_host:={{gcs_host}} _local_mqtt_host:=mqtt_local _performance_analysis:=False

run_perf:
    python src/dr_onboard_autonomy/state_machine.py _uav_name:={{drone_name}} _mqtt_host:={{gcs_host}} _local_mqtt_host:=mqtt_local _performance_analysis:=True _comment:=`git rev-parse --short HEAD`

# send MISSION drone_name:
#     ./scripts/send_mission.sh {{drone_name}} missions/{{MISSION}}.json

# echo-px4-restart-cmd:
#     # Due to a Docker-outside-Docker issue, this command is incompatible with
#     # our dev container. Please execute it directly in the host's shell instead.
#     @echo
#     @echo 'docker compose kill px4 && docker compose rm px4 && docker compose up -d --no-deps px4'

# These commands don't work inside the dev container
# But they will work if you run "just" in your native shell
# px4-restart:
#     docker compose kill px4 && docker compose rm --force px4 && docker compose up -d --no-deps px4

# px4-stop:
#     docker compose kill px4 && docker compose rm px4

# px4-start:
#     docker compose up -d --no-deps px4

# px4-cp-logs:
#     mkdir -p ~/Desktop/px4-logs/
#     docker compose cp px4:/home/user/Firmware/build/px4_sitl_default/logs/`date -u -I` ~/Desktop/px4-logs/
