unit-test:
    docker compose -f ./docker/tests-compose.yaml run gh_actions_unit_tests

send-mission MISSION_FILE DRONE=drone_name MQTT_HOST=gcs_host:
    cat {{MISSION_FILE}} |  mosquitto_pub -h {{MQTT_HOST}} -t 'drone/{{DRONE}}/mission-spec' -s --id `./scripts/mk-mqtt-id.sh SEND-MISSION-SCRIPT`

list-missions:
    python3 scripts/list-missions.py

generate-drones NUM:
    python3 scripts/generate-drones.py {{NUM}}

list-simulations:
    echo local
    echo multi
    echo serial

simulate-local-px4 *FLAGS:
    docker compose -f ./docker/simulations/local-px4.yaml up {{FLAGS}}

simulate-local-ardupilot *FLAGS:
    docker compose -f ./docker/simulations/local-ardupilot.yaml up {{FLAGS}}

simulate *FLAGS:
    docker compose -f ./docker/simulations/local-ardupilot.yaml up mqtt_local mavros roscore ardupilot {{FLAGS}}

simulate-multi NUM_DRONES *FLAGS:
    just generate-drones {{NUM_DRONES}} && \
    docker compose -f ./docker/simulations/multi.yaml up {{FLAGS}}

simulate-ardupilot-serial:
    docker compose -f ./docker/simulations/ardupilot-serial.yaml up

simulate-px4-serial:
    docker compose -f ./docker/simulations/px4-serial.yaml up

start-drone DRONE:
    docker compose -f ./docker/drone/{{DRONE}}.yaml up

purge-containers:
    docker ps -a --filter "name=^dr-onboard-autonomy-" -q | xargs docker rm -f

docker-compose *ARGS:
    docker compose -f ./docker/common.yaml {{ARGS}}

octo-start:
    just send-mission missions/Octagon/Red-start.json Red
    just send-mission missions/Octagon/Lime-start.json Lime
    just send-mission missions/Octagon/Aqua-start.json Aqua
    just send-mission missions/Octagon/Fuchsia-start.json Fuchsia
    just send-mission missions/Octagon/DodgerBlue-start.json DodgerBlue
    just send-mission missions/Octagon/Gold-start.json Gold
    just send-mission missions/Octagon/Orange-start.json Orange
    just send-mission missions/Octagon/Violet-start.json Violet

octo-run:
