chain-lake-deadlock-test:
    just send-mission missions/Chain-Lake/red-deadlock-test.json red
    just send-mission missions/Chain-Lake/lime-deadlock-test.json lime

chain-lake-deadlock-tasks:
    MQTT_SERVER={{gcs_host}} bash ./scripts/send_task.sh new missions/tasks/Chain-Lake/deadlock-task-lime.json.txt --name lime
    MQTT_SERVER={{gcs_host}} bash ./scripts/send_task.sh new missions/tasks/Chain-Lake/deadlock-task-red.json.txt --name red

chain-lake-deadlock-end:
    MQTT_SERVER={{gcs_host}} bash ./scripts/send_task.sh end missions/tasks/end-task-loop.json.txt --name red
    MQTT_SERVER={{gcs_host}} bash ./scripts/send_task.sh end missions/tasks/end-task-loop.json.txt --name lime